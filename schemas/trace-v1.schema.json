{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy": {
      "const": "snapshot"
    },
    "snapshot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 10000
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "page"
              },
              "request_cursor": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[!-~]{1,256}$",
                    "maxLength": 256,
                    "not": {
                      "pattern": "[^!-~]"
                    }
                  }
                ]
              },
              "ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "maxItems": 1000
              },
              "next_cursor": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[!-~]{1,256}$",
                    "maxLength": 256,
                    "not": {
                      "pattern": "[^!-~]"
                    }
                  }
                ]
              }
            },
            "required": [
              "type",
              "request_cursor",
              "ids",
              "next_cursor"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "insert"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "delete"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "page"
          }
        },
        "required": [
          "type"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "policy",
    "snapshot",
    "page_size",
    "events"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CursorRace trace v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      }
    }
  },
  "$comment": "Lexical integer rules, file/depth/aggregate limits, ledger and domain semantics are additionally defined in docs/03-contracts.md."
}
